Porto Windows force-stop fix for Lima v2.2.0 (Apache-2.0).

SIGKILL must terminate the selected process tree, not send CTRL_BREAK_EVENT.
Consoleless desktop processes cannot rely on console events, and surviving
children can retain the host-agent log handles and block the next startup.
Stop the host-agent tree before its driver to prevent orphaning children.
Propagate failures before deleting PID files, restarting, or deleting a VM.
Other signals retain upstream behavior.

diff --git a/pkg/osutil/osutil_windows.go b/pkg/osutil/osutil_windows.go
--- a/pkg/osutil/osutil_windows.go
+++ b/pkg/osutil/osutil_windows.go
@@ -9,7 +9,11 @@ import (
 	"fmt"
 	"io/fs"
 	"os"
+	"os/exec"
+	"strconv"
+	"strings"
 	"syscall"
+	"time"
 
 	"golang.org/x/sys/windows"
 )
@@ -38,8 +42,53 @@ const SigKill = Signal(9)
 
 type Signal int
 
-func SysKill(pid int, _ Signal) error {
-	return windows.GenerateConsoleCtrlEvent(syscall.CTRL_BREAK_EVENT, uint32(pid))
+func SysKill(pid int, sig Signal) error {
+	if sig != SigKill {
+		return windows.GenerateConsoleCtrlEvent(syscall.CTRL_BREAK_EVENT, uint32(pid))
+	}
+	if pid <= 0 {
+		return fmt.Errorf("cannot force stop invalid process ID %d", pid)
+	}
+	handle, err := windows.OpenProcess(windows.SYNCHRONIZE, false, uint32(pid))
+	if errors.Is(err, windows.ERROR_INVALID_PARAMETER) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("open process %d for forced stop: %w", pid, err)
+	}
+	defer windows.CloseHandle(handle)
+
+	result, err := windows.WaitForSingleObject(handle, 0)
+	if err != nil {
+		return fmt.Errorf("inspect process %d before forced stop: %w", pid, err)
+	}
+	if result == windows.WAIT_OBJECT_0 {
+		return nil
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "taskkill.exe", "/PID", strconv.Itoa(pid), "/T", "/F")
+	cmd.SysProcAttr = &syscall.SysProcAttr{
+		HideWindow:    true,
+		CreationFlags: windows.CREATE_NO_WINDOW,
+	}
+	cmd.WaitDelay = 5 * time.Second
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		if ctx.Err() != nil {
+			err = ctx.Err()
+		}
+		return fmt.Errorf("force stop process tree %d: %w: %s", pid, err, strings.TrimSpace(string(output)))
+	}
+	result, err = windows.WaitForSingleObject(handle, 5000)
+	if err != nil {
+		return fmt.Errorf("wait for process %d to stop: %w", pid, err)
+	}
+	if result != windows.WAIT_OBJECT_0 {
+		return fmt.Errorf("wait for process %d to stop: %w", pid, context.DeadlineExceeded)
+	}
+	return nil
 }
 
