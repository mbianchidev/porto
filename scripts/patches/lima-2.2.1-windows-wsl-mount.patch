@@ -0,0 +1,36 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package limayaml
+
+import (
+	"os"
+	"runtime"
+	"syscall"
+	"testing"
+)
+
+func TestOfflineWSLMountKeepsOnlyDisconnectedProviderErrorsRecoverable(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		location string
+		err      error
+		offline  bool
+	}{
+		{"localhost", `\\wsl.localhost\selected\root`, syscall.Errno(1), true},
+		{"legacy alias", `\\wsl$\selected\home\synthetic`, syscall.Errno(1), true},
+		{"case insensitive", `\\WSL.LOCALHOST\selected\root`, syscall.Errno(1), true},
+		{"wrapped provider", `\\wsl.localhost\selected\root`, &os.PathError{Op: "CreateFile", Err: syscall.Errno(1)}, true},
+		{"access denied", `\\wsl.localhost\selected\root`, syscall.Errno(5), false},
+		{"ordinary UNC", `\\server\project`, syscall.Errno(1), false},
+		{"lookalike server", `\\wsl.localhost.example\selected`, syscall.Errno(1), false},
+		{"local directory", `C:\synthetic`, syscall.Errno(1), false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			want := test.offline && runtime.GOOS == "windows"
+			if got := offlineWSLMount(test.location, test.err); got != want {
+				t.Fatalf("offline mount = %t, want %t", got, want)
+			}
+		})
+	}
+}
