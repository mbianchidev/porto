+func offlineWSLMount(location string, err error) bool {
+	// A reconnecting WSL file provider can reject directory metadata handles.
+	// Keep its existing mount configuration valid, just as for a missing root.
+	if runtime.GOOS != "windows" || !errors.Is(err, syscall.Errno(1)) {
+		return false
+	}
+	location = strings.ToLower(strings.ReplaceAll(location, "/", `\`))
+	return strings.HasPrefix(location, `\\wsl.localhost\`) || strings.HasPrefix(location, `\\wsl$\`)
+}
