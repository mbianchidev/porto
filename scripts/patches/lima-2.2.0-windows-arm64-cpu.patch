Porto Windows ARM64 CPU feature detection for Lima v2.2.0 (Apache-2.0).

golang.org/x/sys/cpu fills ARM64 feature bits through the Windows processor
feature API without setting Initialized, just as Linux's HWCAP path does.
Use those actual bits rather than reporting a failed CPU probe on every SSH
command. This also keeps that spurious warning out of runtime JSON responses.

diff --git a/pkg/sshutil/sshutil.go b/pkg/sshutil/sshutil.go
--- a/pkg/sshutil/sshutil.go
+++ b/pkg/sshutil/sshutil.go
@@ -735,7 +735,7 @@
 func detectAESAcceleration() bool {
 	if !cpu.Initialized {
-		if runtime.GOOS == "linux" && runtime.GOARCH == "arm64" {
-			// cpu.Initialized seems to always be false, even when the cpu.ARM64 struct is filled out
-			// it is only being set by readARM64Registers, but not by readHWCAP or readLinuxProcCPUInfo
+		if runtime.GOARCH == "arm64" && (runtime.GOOS == "linux" || runtime.GOOS == "windows") {
+			// HWCAP and the Windows processor feature API fill ARM64 bits without
+			// setting Initialized; only the direct register reader sets that flag.
 			return cpu.ARM64.HasAES
 		}
diff --git a/pkg/sshutil/cpu_windows_arm64_test.go b/pkg/sshutil/cpu_windows_arm64_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/sshutil/cpu_windows_arm64_test.go
@@ -0,0 +1,16 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package sshutil
+
+import (
+	"testing"
+
+	"golang.org/x/sys/cpu"
+)
+
+func TestWindowsARM64AESUsesOSFeatureBits(t *testing.T) {
+	if got := detectAESAcceleration(); got != cpu.ARM64.HasAES {
+		t.Fatalf("AES acceleration = %v, OS feature bit = %v", got, cpu.ARM64.HasAES)
+	}
+}
