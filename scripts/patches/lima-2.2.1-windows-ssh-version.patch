Porto native Windows OpenSSH version detection for Lima v2.2.1 (Apache-2.0).

The OS client reports OpenSSH_for_Windows_ rather than OpenSSH_. Treating it
as version zero disables Lima's cipher selection, including its AES preference.
Keep the same version threshold and CPU feature check for both banner forms.

diff --git a/pkg/sshutil/sshutil.go b/pkg/sshutil/sshutil.go
--- a/pkg/sshutil/sshutil.go
+++ b/pkg/sshutil/sshutil.go
@@ -633,5 +633,5 @@
 func ParseOpenSSHVersion(version []byte) *semver.Version {
-	regex := regexp.MustCompile(`(?m)^OpenSSH_(\d+\.\d+)(?:p(\d+))?\b`)
+	regex := regexp.MustCompile(`(?m)^OpenSSH_(?:for_Windows_)?(\d+\.\d+)(?:p(\d+))?\b`)
 	matches := regex.FindSubmatch(version)
 	if len(matches) == 3 {
 		if len(matches[2]) == 0 {
diff --git a/pkg/sshutil/sshutil_porto_test.go b/pkg/sshutil/sshutil_porto_test.go
