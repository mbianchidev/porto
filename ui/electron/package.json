{
  "name": "porto-desktop-shell",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal Electron shell that loads the Porto control surface from the local daemon.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Porto --overwrite --prune=true"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.0.0"
  }
}
